@page
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model SuccessModel
@{
    ViewData["Title"] = "Checkout Complete";
    var imageBaseUrl = (Configuration["ImageBaseUrl"] ?? "").TrimEnd('/');
}

<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="@($"{imageBaseUrl}/images/main_banner_text.png")" />
    </div>
</section>

<div class="container">
    <h1>Thanks for your Order!</h1>

    <a asp-page="/Index">Continue Shopping...</a>
</div>